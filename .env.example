# Cauce — variables de entorno (copiar a .env). El .env real está en .gitignore.

# PostgreSQL (docker-compose)
POSTGRES_USER=cauce
POSTGRES_PASSWORD=cauce
POSTGRES_DB=cauce
POSTGRES_PORT=5432

# Cadena de conexión de la app
DATABASE_URL=postgresql+psycopg://cauce:cauce@localhost:5432/cauce

# Simulación (determinismo — ADR-006)
CAUCE_N_TRAYECTORIAS=10000
CAUCE_SEMILLA_DEFAULT=42
